{
  "name": "motion-project",
  "version": "1.0.0",
  "description": "Motion graphics built with Remotion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Engr-Samson-Beloved/Motion_Project.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.0",
    "@remotion/cli": "4.0.517",
    "@remotion/gsap": "4.0.517",
    "@remotion/layout-utils": "4.0.517",
    "@remotion/media-utils": "4.0.517",
    "@remotion/motion-blur": "4.0.517",
    "@remotion/noise": "4.0.517",
    "@remotion/paths": "4.0.517",
    "@remotion/shapes": "4.0.517",
    "@remotion/tailwind-v4": "4.0.517",
    "@remotion/three": "4.0.517",
    "@remotion/transitions": "4.0.517",
    "gsap": "3.15.0",
    "postprocessing": "6.39.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.517",
    "tailwindcss": "4.0.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.517",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.1",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "scripts": {
    "dev": "remotion studio",
    "web": "vite",
    "build": "node scripts/check-assets.js && vite build",
    "preview": "vite preview",
    "bundle": "remotion bundle",
    "upgrade": "remotion upgrade",
    "storyboard": "remotion still Storyboard out/storyboard.png --gl=angle",
    "story-board": "remotion still StoryBoard out/story-board.png",
    "vo-sheet": "node scripts/vo-sheet.js out/vo-script.txt",
    "bed90": "node scripts/make-bed90.js",
    "bed30": "node scripts/make-bed30.js",
    "bed38": "node scripts/make-bed38.js",
    "bed36": "node scripts/make-bed36.js",
    "bed16": "node scripts/make-bed16.js",
    "bed-update": "node scripts/make-bed-update.js",
    "screens": "node scripts/patch-screens.js",
    "probe-screens": "node scripts/probe-screens.js",
    "probe-clip": "node scripts/probe-clip.js",
    "tour-board": "remotion still CampusTourBoard out/campus-tour-board.png",
    "install-board": "remotion still AddToHomeBoard out/add-to-home-board.png",
    "month-poster": "remotion still MonthPoster out/september-2026-poster.png",
    "same-board": "remotion still SameQuestionBoard out/same-question-board.png",
    "char-sheet": "remotion still CharacterSheet out/character-sheet.png",
    "measure": "node scripts/measure-png.js",
    "ref": "node scripts/analyze-ref.js",
    "lint": "eslint src web && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
