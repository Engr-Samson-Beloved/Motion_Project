node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Reference media is often large and rarely ours to redistribute. The .json
# style profiles derived from it are small and committed, so the target still
# travels with the repo.
refs/*
!refs/README.md
!refs/*.json

# Captured app screens: large, stale quickly, may hold real user data.
public/screens/*
!public/screens/README.md
