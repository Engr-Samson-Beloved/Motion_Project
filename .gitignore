node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Reference media is often large and rarely ours to redistribute. The .json
# style profiles derived from it are small and committed, so the target still
# travels with the repo.
refs/*
!refs/README.md
!refs/*.json

# Captured app screens were kept out of the repo while they were only ever
# needed on the machine that captured them. CampusTour is built from them, so a
# deployed build needs them too, and they are now tracked.
#
# The reason they were ignored has not stopped being true: they are large, they
# go stale quickly, and a capture of a signed-in session can carry real user
# data. Look at a new capture before adding it.
